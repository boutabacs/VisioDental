# Copier vers .env puis renseigner les secrets.
# DATABASE_URL peut être reprise du .env racine, en remplaçant
# « postgresql+asyncpg:// » par « postgresql:// » (Prisma).
DATABASE_URL=postgresql://dental:change-me@localhost:5432/dental_clinic

# Doit être identique au backend FastAPI pendant la bascule : les JWT
# émis par l'un doivent être acceptés par l'autre.
SECRET_KEY=change-me-with-a-64-char-random-hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=30

ENVIRONMENT=development
PORT=8100
COOKIE_DOMAIN=
# Origines autorisées, séparées par des virgules (frontend Nuxt).
ALLOWED_ORIGINS=http://localhost:3000
DEMO_MODE=false
