generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agent_approval_queue {
  id             String         @id @db.Uuid
  agent_id       String         @db.Uuid
  session_id     String         @db.Uuid
  clinic_id      String         @db.Uuid
  tool_name      String         @db.VarChar(200)
  arguments      Json           @default("{}")
  reason         String?        @db.VarChar(500)
  status         String         @default("pending") @db.VarChar(20)
  reviewed_by    String?        @db.Uuid
  reviewed_at    DateTime?      @db.Timestamptz(6)
  review_notes   String?        @db.VarChar(1000)
  created_at     DateTime       @db.Timestamptz(6)
  updated_at     DateTime       @db.Timestamptz(6)
  agents         agents         @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinics        clinics        @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?         @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction)
  agent_sessions agent_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_id], map: "ix_agent_approval_queue_agent_id")
  @@index([clinic_id], map: "ix_agent_approval_queue_clinic_id")
  @@index([session_id], map: "ix_agent_approval_queue_session_id")
  @@index([clinic_id, status, created_at], map: "ix_approval_pending")
}

model agent_audit_logs {
  id                String         @id @db.Uuid
  agent_id          String         @db.Uuid
  session_id        String         @db.Uuid
  clinic_id         String         @db.Uuid
  supervisor_id     String?        @db.Uuid
  tool_name         String         @db.VarChar(200)
  tool_arguments    Json           @default("{}")
  result            Json?
  error             String?        @db.VarChar(2000)
  status            String         @db.VarChar(20)
  execution_time_ms Int            @default(0)
  created_at        DateTime       @db.Timestamptz(6)
  updated_at        DateTime       @db.Timestamptz(6)
  agents            agents         @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinics           clinics        @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_sessions    agent_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users?         @relation(fields: [supervisor_id], references: [id], onUpdate: NoAction)

  @@index([agent_id], map: "ix_agent_audit_logs_agent_id")
  @@index([clinic_id], map: "ix_agent_audit_logs_clinic_id")
  @@index([session_id], map: "ix_agent_audit_logs_session_id")
  @@index([tool_name], map: "ix_agent_audit_logs_tool_name")
  @@index([clinic_id, created_at], map: "ix_audit_clinic_time")
}

model agent_sessions {
  id                    String                  @id @db.Uuid
  agent_id              String                  @db.Uuid
  clinic_id             String                  @db.Uuid
  supervisor_id         String?                 @db.Uuid
  status                String                  @default("active") @db.VarChar(20)
  session_metadata      Json                    @default("{}")
  ended_at              DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @db.Timestamptz(6)
  updated_at            DateTime                @db.Timestamptz(6)
  agent_approval_queue  agent_approval_queue[]
  agent_audit_logs      agent_audit_logs[]
  agents                agents                  @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinics               clinics                 @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                  @relation(fields: [supervisor_id], references: [id], onUpdate: NoAction)
  copilot_conversations copilot_conversations[]

  @@index([agent_id], map: "ix_agent_sessions_agent_id")
  @@index([clinic_id], map: "ix_agent_sessions_clinic_id")
}

model agents {
  id                   String                 @id @db.Uuid
  clinic_id            String                 @db.Uuid
  name                 String                 @db.VarChar(100)
  type                 String                 @db.VarChar(100)
  mode                 String                 @db.VarChar(20)
  config               Json                   @default("{}")
  status               String                 @default("active") @db.VarChar(20)
  created_at           DateTime               @db.Timestamptz(6)
  updated_at           DateTime               @db.Timestamptz(6)
  agent_approval_queue agent_approval_queue[]
  agent_audit_logs     agent_audit_logs[]
  agent_sessions       agent_sessions[]
  clinics              clinics                @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clinic_id], map: "ix_agents_clinic_id")
  @@index([clinic_id, type], map: "ix_agents_clinic_type")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model appointment_cabinet_events {
  id                                                            String       @id @db.Uuid
  clinic_id                                                     String       @db.Uuid
  appointment_id                                                String       @db.Uuid
  from_cabinet_id                                               String?      @db.Uuid
  to_cabinet_id                                                 String?      @db.Uuid
  changed_at                                                    DateTime     @default(now()) @db.Timestamptz(6)
  changed_by                                                    String?      @db.Uuid
  note                                                          String?
  created_at                                                    DateTime     @default(now()) @db.Timestamptz(6)
  appointments                                                  appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                                         users?       @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinics                                                       clinics      @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cabinets_appointment_cabinet_events_from_cabinet_idTocabinets cabinets?    @relation("appointment_cabinet_events_from_cabinet_idTocabinets", fields: [from_cabinet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cabinets_appointment_cabinet_events_to_cabinet_idTocabinets   cabinets?    @relation("appointment_cabinet_events_to_cabinet_idTocabinets", fields: [to_cabinet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appointment_id, changed_at], map: "ix_appointment_cabinet_events_appointment_changed_at")
  @@index([appointment_id], map: "ix_appointment_cabinet_events_appointment_id")
  @@index([clinic_id], map: "ix_appointment_cabinet_events_clinic_id")
}

model appointment_status_events {
  id             String       @id @db.Uuid
  clinic_id      String       @db.Uuid
  appointment_id String       @db.Uuid
  from_status    String?      @db.VarChar(20)
  to_status      String       @db.VarChar(20)
  changed_at     DateTime     @default(now()) @db.Timestamptz(6)
  changed_by     String?      @db.Uuid
  note           String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  appointments   appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?       @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinics        clinics      @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appointment_id, changed_at], map: "ix_appointment_status_events_appointment_changed_at")
  @@index([appointment_id], map: "ix_appointment_status_events_appointment_id")
  @@index([clinic_id], map: "ix_appointment_status_events_clinic_id")
}

model appointment_treatments {
  id                        String                   @id @db.Uuid
  appointment_id            String                   @db.Uuid
  planned_treatment_item_id String                   @db.Uuid
  catalog_item_id           String?                  @db.Uuid
  display_order             Int
  created_at                DateTime                 @default(now()) @db.Timestamptz(6)
  completed_in_appointment  Boolean
  notes                     String?
  appointments              appointments             @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatment_catalog_items   treatment_catalog_items? @relation(fields: [catalog_item_id], references: [id], onUpdate: NoAction)
  planned_treatment_items   planned_treatment_items  @relation(fields: [planned_treatment_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appointment_treatments_planned_item")

  @@index([appointment_id], map: "ix_appointment_treatments_appointment_id")
  @@index([planned_treatment_item_id], map: "ix_appointment_treatments_planned_treatment_item_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id                                            String                       @id @db.Uuid
  clinic_id                                     String                       @db.Uuid
  patient_id                                    String?                      @db.Uuid
  professional_id                               String                       @db.Uuid
  cabinet                                       String?                      @db.VarChar(50)
  cabinet_id                                    String?                      @db.Uuid
  start_time                                    DateTime                     @db.Timestamptz(6)
  end_time                                      DateTime                     @db.Timestamptz(6)
  treatment_type                                String?                      @db.VarChar(100)
  status                                        String                       @db.VarChar(20)
  color                                         String?                      @db.VarChar(7)
  created_at                                    DateTime                     @db.Timestamptz(6)
  updated_at                                    DateTime                     @db.Timestamptz(6)
  current_status_since                          DateTime                     @default(now()) @db.Timestamptz(6)
  cabinet_assigned_at                           DateTime?                    @db.Timestamptz(6)
  cabinet_assigned_by                           String?                      @db.Uuid
  appointment_cabinet_events                    appointment_cabinet_events[]
  appointment_status_events                     appointment_status_events[]
  appointment_treatments                        appointment_treatments[]
  users_appointments_cabinet_assigned_byTousers users?                       @relation("appointments_cabinet_assigned_byTousers", fields: [cabinet_assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cabinets                                      cabinets?                    @relation(fields: [cabinet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinics                                       clinics                      @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients                                      patients?                    @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_appointments_professional_idTousers     users                        @relation("appointments_professional_idTousers", fields: [professional_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recalls                                       recalls[]

  @@index([cabinet_id], map: "ix_appointments_cabinet_id")
  @@index([clinic_id], map: "ix_appointments_clinic_id")
  @@index([start_time], map: "ix_appointments_start_time")
}

model auth_refresh_tokens {
  id              String    @id @db.Uuid
  user_id         String    @db.Uuid
  family_id       String    @db.Uuid
  issued_at       DateTime  @db.Timestamptz(6)
  expires_at      DateTime  @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  replaced_by     String?   @db.Uuid
  user_agent_hash String?   @db.VarChar(64)
  last_ip         String?   @db.VarChar(64)
  users           users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([family_id], map: "ix_auth_refresh_tokens_family_id")
  @@index([user_id], map: "ix_auth_refresh_tokens_user_id")
}

model budget_access_logs {
  id               String   @id @db.Uuid
  budget_id        String   @db.Uuid
  attempted_at     DateTime @default(now()) @db.Timestamptz(6)
  ip_hash          String   @db.VarChar(64)
  success          Boolean
  method_attempted String   @db.VarChar(20)
  budgets          budgets  @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([budget_id, attempted_at], map: "idx_budget_access_logs_budget_attempted")
}

model budget_history {
  id             String   @id @db.Uuid
  clinic_id      String   @db.Uuid
  budget_id      String   @db.Uuid
  action         String   @db.VarChar(30)
  changed_by     String   @db.Uuid
  changed_at     DateTime @db.Timestamptz(6)
  previous_state Json?
  new_state      Json?
  notes          String?
  budgets        budgets  @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users    @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinics        clinics  @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([budget_id], map: "idx_budget_history_budget")
  @@index([changed_at], map: "idx_budget_history_changed_at")
  @@index([clinic_id], map: "idx_budget_history_clinic")
  @@index([budget_id], map: "ix_budget_history_budget_id")
  @@index([clinic_id], map: "ix_budget_history_clinic_id")
}

model budget_items {
  id                      String                  @id @db.Uuid
  clinic_id               String                  @db.Uuid
  budget_id               String                  @db.Uuid
  catalog_item_id         String                  @db.Uuid
  unit_price              Decimal                 @db.Decimal(10, 2)
  quantity                Int
  discount_type           String?                 @db.VarChar(20)
  discount_value          Decimal?                @db.Decimal(10, 2)
  vat_type_id             String?                 @db.Uuid
  vat_rate                Float
  line_subtotal           Decimal                 @db.Decimal(10, 2)
  line_discount           Decimal                 @db.Decimal(10, 2)
  line_tax                Decimal                 @db.Decimal(10, 2)
  line_total              Decimal                 @db.Decimal(10, 2)
  tooth_number            Int?
  surfaces                Json?
  treatment_id            String?                 @db.Uuid
  invoiced_quantity       Int
  display_order           Int
  notes                   String?
  created_at              DateTime                @db.Timestamptz(6)
  updated_at              DateTime                @db.Timestamptz(6)
  budgets                 budgets                 @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatment_catalog_items treatment_catalog_items @relation(fields: [catalog_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinics                 clinics                 @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  treatments              treatments?             @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vat_types               vat_types?              @relation(fields: [vat_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_items           invoice_items[]

  @@index([budget_id], map: "idx_budget_items_budget")
  @@index([catalog_item_id], map: "idx_budget_items_catalog")
  @@index([budget_id, tooth_number], map: "idx_budget_items_tooth")
  @@index([treatment_id], map: "idx_budget_items_treatment")
  @@index([budget_id], map: "ix_budget_items_budget_id")
  @@index([catalog_item_id], map: "ix_budget_items_catalog_item_id")
  @@index([clinic_id], map: "ix_budget_items_clinic_id")
  @@index([treatment_id], map: "ix_budget_items_treatment_id")
  @@index([vat_type_id], map: "ix_budget_items_vat_type_id")
}

model budget_signatures {
  id                      String   @id @db.Uuid
  clinic_id               String   @db.Uuid
  budget_id               String   @db.Uuid
  signature_type          String   @db.VarChar(30)
  signed_items            Json?
  signed_by_name          String   @db.VarChar(200)
  signed_by_email         String?  @db.VarChar(255)
  relationship_to_patient String   @db.VarChar(30)
  signature_method        String   @db.VarChar(30)
  signature_data          Json?
  ip_address              String?  @db.VarChar(45)
  user_agent              String?
  signed_at               DateTime @db.Timestamptz(6)
  external_signature_id   String?  @db.VarChar(255)
  external_provider       String?  @db.VarChar(50)
  document_hash           String?  @db.VarChar(64)
  created_at              DateTime @db.Timestamptz(6)
  budgets                 budgets  @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinics                 clinics  @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([budget_id], map: "idx_budget_signatures_budget")
  @@index([clinic_id], map: "idx_budget_signatures_clinic")
  @@index([budget_id], map: "ix_budget_signatures_budget_id")
  @@index([clinic_id], map: "ix_budget_signatures_clinic_id")
}

model budgets {
  id                                            String                @id @db.Uuid
  clinic_id                                     String                @db.Uuid
  patient_id                                    String                @db.Uuid
  budget_number                                 String                @db.VarChar(50)
  version                                       Int
  parent_budget_id                              String?               @db.Uuid
  status                                        String                @db.VarChar(30)
  valid_from                                    DateTime              @db.Date
  valid_until                                   DateTime?             @db.Date
  created_by                                    String                @db.Uuid
  assigned_professional_id                      String?               @db.Uuid
  global_discount_type                          String?               @db.VarChar(20)
  global_discount_value                         Decimal?              @db.Decimal(10, 2)
  subtotal                                      Decimal               @db.Decimal(12, 2)
  total_discount                                Decimal               @db.Decimal(12, 2)
  total_tax                                     Decimal               @db.Decimal(12, 2)
  total                                         Decimal               @db.Decimal(12, 2)
  internal_notes                                String?
  patient_notes                                 String?
  insurance_estimate                            Decimal?              @db.Decimal(12, 2)
  deleted_at                                    DateTime?             @db.Timestamptz(6)
  created_at                                    DateTime              @db.Timestamptz(6)
  updated_at                                    DateTime              @db.Timestamptz(6)
  accepted_via                                  String?               @db.VarChar(20)
  rejection_reason                              String?               @db.VarChar(50)
  rejection_note                                String?
  public_token                                  String                @unique(map: "idx_budgets_public_token") @db.Uuid
  viewed_at                                     DateTime?             @db.Timestamptz(6)
  last_reminder_sent_at                         DateTime?             @db.Timestamptz(6)
  public_auth_method                            String                @db.VarChar(20)
  public_auth_secret_hash                       String?               @db.VarChar(255)
  public_locked_at                              DateTime?             @db.Timestamptz(6)
  plan_number_snapshot                          String?               @db.VarChar(50)
  plan_status_snapshot                          String?               @db.VarChar(20)
  budget_access_logs                            budget_access_logs[]
  budget_history                                budget_history[]
  budget_items                                  budget_items[]
  budget_signatures                             budget_signatures[]
  users_budgets_assigned_professional_idTousers users?                @relation("budgets_assigned_professional_idTousers", fields: [assigned_professional_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinics                                       clinics               @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_budgets_created_byTousers               users                 @relation("budgets_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budgets                                       budgets?              @relation("budgetsTobudgets", fields: [parent_budget_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_budgets                                 budgets[]             @relation("budgetsTobudgets")
  patients                                      patients              @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices                                      invoices[]
  payment_allocations                           payment_allocations[]
  treatment_plans                               treatment_plans?

  @@unique([clinic_id, budget_number, version], map: "uq_budget_clinic_number_version")
  @@index([clinic_id], map: "idx_budgets_clinic")
  @@index([clinic_id, patient_id], map: "idx_budgets_clinic_patient")
  @@index([clinic_id, status], map: "idx_budgets_clinic_status")
  @@index([parent_budget_id], map: "idx_budgets_parent")
  @@index([valid_until], map: "idx_budgets_valid_until")
  @@index([clinic_id], map: "ix_budgets_clinic_id")
  @@index([parent_budget_id], map: "ix_budgets_parent_budget_id")
  @@index([patient_id], map: "ix_budgets_patient_id")
}

model cabinets {
  id                                                                              String                       @id @db.Uuid
  clinic_id                                                                       String                       @db.Uuid
  name                                                                            String                       @db.VarChar(50)
  color                                                                           String                       @db.VarChar(7)
  display_order                                                                   Int
  is_active                                                                       Boolean
  created_at                                                                      DateTime                     @db.Timestamptz(6)
  updated_at                                                                      DateTime                     @db.Timestamptz(6)
  appointment_cabinet_events_appointment_cabinet_events_from_cabinet_idTocabinets appointment_cabinet_events[] @relation("appointment_cabinet_events_from_cabinet_idTocabinets")
  appointment_cabinet_events_appointment_cabinet_events_to_cabinet_idTocabinets   appointment_cabinet_events[] @relation("appointment_cabinet_events_to_cabinet_idTocabinets")
  appointments                                                                    appointments[]
  clinics                                                                         clinics                      @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([clinic_id, name], map: "uq_cabinet_clinic_name")
  @@index([clinic_id], map: "ix_cabinets_clinic_id")
}

model catalog_item_sessions {
  id                      String                  @id @db.Uuid
  catalog_item_id         String                  @db.Uuid
