  labels                  Json                    @default("{}")
  default_price           Decimal                 @db.Decimal(10, 2)
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                @default(now()) @db.Timestamptz(6)
  treatment_catalog_items treatment_catalog_items @relation(fields: [catalog_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([catalog_item_id, sequence], map: "uq_catalog_session_item_sequence")
  @@index([catalog_item_id], map: "idx_catalog_sessions_item")
}

model clinic_channel_settings {
  id           String   @id @db.Uuid
  clinic_id    String   @db.Uuid
  channel      String   @db.VarChar(20)
  adapter_name String   @db.VarChar(50)
  is_enabled   Boolean
  is_verified  Boolean
  config       Json?
  created_at   DateTime @db.Timestamptz(6)
  updated_at   DateTime @db.Timestamptz(6)
  clinics      clinics  @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([clinic_id, channel], map: "uq_clinic_channel_settings_clinic_channel")
  @@index([clinic_id], map: "idx_clinic_channel_settings_clinic")
  @@index([clinic_id], map: "ix_clinic_channel_settings_clinic_id")
}

model clinic_memberships {
  id              String   @id @db.Uuid
  user_id         String   @db.Uuid
  clinic_id       String   @db.Uuid
  role            String   @db.VarChar(20)
  created_at      DateTime @db.Timestamptz(6)
  updated_at      DateTime @db.Timestamptz(6)
  is_professional Boolean  @default(false)
  role_id         String?  @db.Uuid
  clinics         clinics  @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles           roles?   @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_clinic_memberships_role_id")

  @@unique([clinic_id, user_id], map: "uq_clinic_memberships_clinic_user")
  @@index([clinic_id], map: "ix_clinic_memberships_clinic_id")
  @@index([role_id], map: "ix_clinic_memberships_role_id")
  @@index([user_id], map: "ix_clinic_memberships_user_id")
}

