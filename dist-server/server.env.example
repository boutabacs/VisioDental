# VisioDental Server — configuration du cabinet
# Généré automatiquement par install-server.ps1 ; à éditer avec un éditeur
# de texte, puis redémarrer le service « VisioDental ».
# Les valeurs CHANGE_ME sont remplacées à l'installation.

# --- Application -----------------------------------------------------------
ENVIRONMENT=production
# API interne : jamais exposée au réseau (proxy /api/v1 du site).
API_HOST=127.0.0.1
PORT=8100
# Site : seul port ouvert sur le pare-feu local.
NUXT_PORT=3000
NUXT_HOST=0.0.0.0
NUXT_API_PROXY=true
# L'interface appelle /api/v1 sur sa propre origine (proxy).
NUXT_PUBLIC_API_BASE_URL=/

# --- Sécurité --------------------------------------------------------------
DATABASE_URL=postgresql://visiodental:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/visiodental?schema=public
SECRET_KEY=CHANGE_ME_SECRET_KEY
# HTTP sur le réseau local : le drapeau Secure empêcherait le navigateur
# d'enregistrer les cookies de session. Passez à true derrière HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=
ALLOWED_ORIGINS=
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- Métier ----------------------------------------------------------------
DEMO_MODE=false
SCHEDULER_ENABLED=true
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=..\data\storage

# --- E-mail (optionnel) ----------------------------------------------------
# console = écrit dans les journaux ; smtp = envoi réel.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=VisioDental
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TLS=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# --- Copilot (optionnel) ---------------------------------------------------
# Fournisseur par défaut du cabinet : openai | anthropic | gemini | ...
COPILOT_PROVIDER_DEFAULT=openai
COPILOT_MODEL_CHAT_OPENAI=gpt-5.4-mini
COPILOT_MODEL_CHAT_GEMINI=gemini-3.5-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
# Rédaction des données patients avant envoi au modèle (recommandé).
COPILOT_REDACTION_DEFAULT=true
